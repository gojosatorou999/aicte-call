# Copy to apps/voice/.env and fill in. NEVER commit the real .env (it is gitignored).
# Run the service from apps/voice so this file is found.

# ---------------------------------------------------------------------------
# 1. NEEDED TO TAKE REAL PHONE CALLS
# ---------------------------------------------------------------------------
# Twilio Console -> Account Info -> Auth Token. Used to verify that webhooks really
# come from Twilio. Keep TWILIO_SIGNATURE_VALIDATION_ENABLED=true everywhere but your
# own laptop when testing with curl / scripts/simulate_call.py.
TWILIO_AUTH_TOKEN=
TWILIO_SIGNATURE_VALIDATION_ENABLED=true

# The public https URL that reaches this service (your ngrok / cloudflared URL),
# no trailing slash. Twilio's signature is computed over this host, so it MUST match
# the URL you typed into the Twilio console.
PUBLIC_VOICE_URL=https://your-name.ngrok-free.app

# ---------------------------------------------------------------------------
# 2. SECRETS YOU INVENT (nothing to sign up for)
#    python -c "import secrets; print(secrets.token_urlsafe(32))"
# ---------------------------------------------------------------------------
# Shared secret between this service and the core API (Bearer token).
INTERNAL_SERVICE_TOKEN=change-me-voice-to-core
# Signs per-call session tokens. Empty = derived from INTERNAL_SERVICE_TOKEN.
# Use 32+ characters.
SESSION_JWT_SECRET=
# Pepper for hashing caller phone numbers (raw numbers are never stored).
CALLER_HASH_PEPPER=dev-only-do-not-use-in-prod
# Required in production only.
ADMIN_API_KEY=

# ---------------------------------------------------------------------------
# 3. HOW CALLS ARE CONVERSED
# ---------------------------------------------------------------------------
#   gather - deterministic Twilio <Gather> graph. NO OpenAI/LLM in the call path. (default)
#   relay  - an LLM writes every reply over Twilio ConversationRelay (needs LLM_API_KEY)
#   hybrid - the gather graph, with the LLM only for questions it cannot answer
CONVERSATION_MODE=gather
# English only by default. en,hi,te,ml,ta,kn brings back the six-language menu.
ENABLED_LANGUAGES=en

# ---------------------------------------------------------------------------
# 4. THE CORE API (Track P). Until it exists, run the bundled mock:
#    uvicorn mock_core.app:app --port 9000
# ---------------------------------------------------------------------------
CORE_BASE_URL=http://localhost:9000/internal/voice

# ---------------------------------------------------------------------------
# 5. ONLY IF CONVERSATION_MODE IS relay OR hybrid
# ---------------------------------------------------------------------------
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# 6. LATER (outbound calls) - not used by the code yet
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_VOICE_NUMBER=

# ---------------------------------------------------------------------------
# 7. OPTIONAL TUNING (defaults shown)
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# COMMITMENT_MAX_DAYS=30
# PIN_MAX_ATTEMPTS=3
# OTP_MAX_ATTEMPTS=3
# PUBLIC_LOOKUPS_PER_CALL=5
# PUBLIC_CALLS_PER_DAY=10
# NO_INPUT_TIMEOUT_MS=6000
# SILENCE_REPROMPTS=2
# MAX_CALL_DURATION_PUBLIC_SEC=360
# MAX_CALL_DURATION_DEFAULT_SEC=600
