# Copy to apps/voice/.env and fill in. NEVER commit the real .env (it is gitignored).
# Run the service from apps/voice so this file is found. Restart the service after editing.

# ---------------------------------------------------------------------------
# 1. TWILIO  (console.twilio.com)  - needed to place and answer real calls
# ---------------------------------------------------------------------------
# Console home -> Account Info. The SID starts with AC.
TWILIO_ACCOUNT_SID=
# Same place; click to reveal. Also verifies that webhooks really come from Twilio.
TWILIO_AUTH_TOKEN=
# The Twilio number the agent calls FROM, in +E.164 form, e.g. +14155552671
# (Phone Numbers -> Manage -> Active numbers). A trial account can only call numbers
# you have verified (Phone Numbers -> Manage -> Verified Caller IDs).
TWILIO_VOICE_NUMBER=
# Keep true everywhere except local testing with curl / scripts/simulate_call.py.
TWILIO_SIGNATURE_VALIDATION_ENABLED=true

# ---------------------------------------------------------------------------
# 2. PUBLIC ADDRESS  - where Twilio reaches this service (your ngrok address)
# ---------------------------------------------------------------------------
# No trailing slash. Must be exactly the address in use: Twilio signs requests over it.
# Also set `api` in dialpad/config.js to the same address.
PUBLIC_VOICE_URL=https://your-name.ngrok-free.dev

# ---------------------------------------------------------------------------
# 3. SECRETS YOU INVENT (nothing to sign up for)
#    python -c "import secrets; print(secrets.token_urlsafe(32))"
# ---------------------------------------------------------------------------
INTERNAL_SERVICE_TOKEN=change-me-voice-to-core
SESSION_JWT_SECRET=
CALLER_HASH_PEPPER=dev-only-do-not-use-in-prod
ADMIN_API_KEY=

# ---------------------------------------------------------------------------
# 4. HOW CALLS ARE CONVERSED
# ---------------------------------------------------------------------------
#   live   - the deterministic graph over Twilio ConversationRelay: streaming speech-to-text,
#            a human-sounding voice, barge-in. NO OpenAI/LLM in the call.   (recommended)
#   gather - the same graph over basic Twilio <Gather>/<Say>. NO LLM. Fallback if `live` is
#            not available on your Twilio account.
#   relay  - an LLM writes every reply (needs LLM_API_KEY)
#   hybrid - gather graph, LLM only for questions it cannot answer (needs LLM_API_KEY)
CONVERSATION_MODE=live
# English only by default. en,hi,te,ml,ta,kn brings back the six-language menu.
ENABLED_LANGUAGES=en

# gather path: the <Say> voice (Polly neural en-IN is what the earlier Sentinel agent used) and
# whether to record calls. A restricted Twilio TRIAL account may refuse the recording element and
# sends no webhook signatures: use CONVERSATION_MODE=gather and RECORD_CALLS=false there.
GATHER_VOICE=Polly.Kajal-Neural
RECORD_CALLS=true
# Accept Twilio's UNSIGNED trial-tier requests for dial-pad calls, but only with the per-call key /
# one-time id (see docs/DECISIONS.md). Set false once your account is upgraded and signs requests.
DIAL_ACCEPT_UNSIGNED_TWIML=true

# Voice / speech-to-text (live, relay). EMPTY = Twilio's default for en-IN (a human-sounding
# ElevenLabs voice). Override only after hearing a call, e.g.:
#   RELAY_STT_PROVIDER=Deepgram   RELAY_STT_MODEL=nova-3-general
#   RELAY_TTS_PROVIDER=ElevenLabs RELAY_VOICE=<voice id>-flash_v2_5
RELAY_TTS_PROVIDER=
RELAY_VOICE=
RELAY_STT_PROVIDER=
RELAY_STT_MODEL=
# How readily the caller can cut in while the agent talks: low | medium | high
RELAY_INTERRUPT_SENSITIVITY=medium
RELAY_IGNORE_BACKCHANNEL=true

# ---------------------------------------------------------------------------
# 5. DIAL PAD  (the web page on GitHub Pages that asks the agent to call you)
# ---------------------------------------------------------------------------
# Optional access code the page asks for. Recommended once you share the link: anyone who finds
# the page could otherwise trigger calls on your Twilio account.
DIAL_PAD_TOKEN=
# Only numbers starting with these prefixes can be dialled (comma-separated; empty = any).
DIAL_ALLOWED_PREFIXES=+91
DIAL_PER_NUMBER_PER_HOUR=3
DIAL_PER_IP_PER_HOUR=10
DIAL_GLOBAL_PER_DAY=100
# Browser origins allowed to call the API (CORS): the page's address.
DIALPAD_ALLOWED_ORIGINS=https://gojosatorou999.github.io,http://localhost:8080
# Offer public / institution / officer / faculty demo calls on the page (mock data only).
DEMO_SCENARIOS=false

# ---------------------------------------------------------------------------
# 5b. ADMIN DASHBOARD + CALL REPORT  (https://<your-address>/admin)
# ---------------------------------------------------------------------------
# Shows every call (the college asked about, the result, complaints) and exports a CSV.
# No password = the dashboard is switched off.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Where the report is kept; calls.csv is rewritten after every call. Local only (gitignored).
CALL_LOG_DB=data/calls.db
CALL_LOG_CSV=data/calls.csv

# ---------------------------------------------------------------------------
# 6. THE CORE API (Track P). Until it exists, run the bundled mock:
#    uvicorn mock_core.app:app --port 9000
# ---------------------------------------------------------------------------
CORE_BASE_URL=http://localhost:9000/internal/voice

# ---------------------------------------------------------------------------
# 7. ONLY IF CONVERSATION_MODE IS relay OR hybrid
# ---------------------------------------------------------------------------
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# 8. OPTIONAL TUNING (defaults shown)
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# COMMITMENT_MAX_DAYS=30
# PIN_MAX_ATTEMPTS=3
# OTP_MAX_ATTEMPTS=3
# PUBLIC_LOOKUPS_PER_CALL=40
# PUBLIC_CALLS_PER_DAY=10
# The agent never hangs up on its own mid-conversation. It waits NO_INPUT_TIMEOUT_MS for the caller,
# says it is still there, and only after SILENCE_END_AFTER silent waits in a row (about two minutes)
# does it end the call, so a dead open line does not run up the bill.
# NO_INPUT_TIMEOUT_MS=10000
# SILENCE_END_AFTER=12
# SILENCE_REPROMPTS=2   (only used by the LLM relay mode)
# MAX_CALL_DURATION_PUBLIC_SEC=1800
# MAX_CALL_DURATION_DEFAULT_SEC=1800
# The AICTE approved-institutions list the demo backend answers from (see README: "Any college name").
# INSTITUTIONS_CSV=data/aicte_institutions.csv
